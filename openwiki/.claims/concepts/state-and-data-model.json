    {
      "id": "claim_9abfb914480f4f2c8cbb8e67eb6f1294",
      "statement": "Claims move through a backend-owned state machine: `start_claim` moves a waiting claim to in_progress, `record_decision` can only decide an in_progress undecided claim, `pay_claim` only pays approved claims, `sign_off_claim` reopens an over-limit approval for resumption, and `fail_claim` returns eligible in-progress undecided claims to the queue or leaves them for a handler after the second attempt.",
      "evidence": [
        {
          "resource": "repo://backend/main.py#L233-L250",
